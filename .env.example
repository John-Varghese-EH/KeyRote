# --- Proxy Auth ---
PROXY_SECRET=super_secret_token_123         # Required. Bearer token for clients.
ADMIN_SECRET=super_secret_admin_456         # Required. Second factor for destructive admin ops.
BASE_URL=http://localhost:3000              # Optional. Included in alert webhook payloads.

# --- Upstream Keys ---
UPSTREAM_API_KEYS=key1,key2,key3            # Required. Comma-separated.
KEY_HEADER_NAME=Authorization               # Optional. Default: Authorization (Bearer)

# --- Rotation ---
ROTATION_STRATEGY=round-robin               # round-robin | least-used
COOLDOWN_MS=60000
MAX_RETRY_ATTEMPTS=3
BASE_DELAY_MS=500
MAX_DELAY_MS=8000

# --- Redis ---
REDIS_URL=redis://localhost:6379            # Required for distributed state
MAX_REDIS_AUDIT_ENTRIES=10000               # Trim audit ZSET to this many entries
MAX_REDIS_ERROR_ENTRIES=2000                # Trim error ZSET to this many entries

# --- Security ---
ALLOWED_ORIGINS=                            # Optional. Comma separated. Empty = allow all.
ALLOWED_IPS=                                # Optional. Empty = allow all.
MAX_REQUESTS_PER_MINUTE=60

# --- Health Checks ---
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_ENDPOINT=https://api.openai.com/v1/models
UPSTREAM_TIMEOUT_MS=30000

# --- Log Rotation & Storage ---
LOG_DIR=./logs                              # Directory for rotated log files
MAX_LOG_FILE_SIZE_MB=50                     # Rotate file after this size
MAX_LOG_FILES=7                             # Max rotated files to keep
MAX_LOG_AGE_DAYS=30                         # Delete files older than this
LOG_CLEANUP_INTERVAL_MS=3600000             # How often to run cleanup (default 1hr)

# --- Alerts ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ALERT_THRESHOLD=0.2
ALERT_DEBOUNCE_MS=300000

# --- Logging ---
LOG_LEVEL=info                              # debug | info | warn | error
PORT=3000
NODE_ENV=production                         # production | development
